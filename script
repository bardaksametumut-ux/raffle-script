-- RAYCAST PARAMS (ESP görüş kontrolü)
-- ============================================================
local RayParams = RaycastParams.new()
RayParams.FilterType = Enum.RaycastFilterType.Exclude
RayParams.FilterDescendantsInstances = {LChar}
LP.CharacterAdded:Connect(function(c)
    RayParams.FilterDescendantsInstances = {c}
end)

local function IsVisible(origin, targetPos)
    local dir = (targetPos - origin)
    local result = Workspace:Raycast(origin, dir, RayParams)
    if not result then return true end
    -- çarptığı şey bir oyuncunun parçasıysa görünür say
    local hit = result.Instance
    return hit and hit.Parent and Players:GetPlayerFromCharacter(hit.Parent) ~= nil
end

