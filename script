    l.Parent    = f
end

local function Toggle(pan, lbl, key, cb)
    local row = Instance.new("Frame")
    row.Size             = UDim2.new(1,0,0,30)
    row.BackgroundColor3 = C.row
    row.BorderSizePixel  = 0
    row.LayoutOrder      = O()
    row.Parent           = pan
    Instance.new("UICorner",row).CornerRadius = UDim.new(0,6)

    local l = Instance.new("TextLabel")
    l.Size      = UDim2.new(0.7,0,1,0)
    l.Position  = UDim2.new(0,10,0,0)
    l.BackgroundTransparency=1
    l.Text      = lbl; l.TextColor3=C.gt
    l.TextSize  = 12; l.Font=Enum.Font.Gotham
    l.TextXAlignment=Enum.TextXAlignment.Left
    l.Parent    = row

    local tf = Instance.new("Frame")
    tf.Size             = UDim2.new(0,40,0,20)
    tf.Position         = UDim2.new(1,-48,0.5,-10)
    tf.BackgroundColor3 = S[key] and C.ton or C.tof
    tf.BorderSizePixel  = 0
    tf.Parent           = row
    Instance.new("UICorner",tf).CornerRadius = UDim.new(1,0)

    local kn = Instance.new("Frame")
    kn.Size             = UDim2.new(0,16,0,16)
    kn.Position         = S[key] and UDim2.new(1,-18,0.5,-8) or UDim2.new(0,2,0.5,-8)
    kn.BackgroundColor3 = C.wh
    kn.BorderSizePixel  = 0
    kn.Parent           = tf
    Instance.new("UICorner",kn).CornerRadius = UDim.new(1,0)

    local btn = Instance.new("TextButton")
    btn.Size=UDim2.new(1,0,1,0); btn.BackgroundTransparency=1; btn.Text=""; btn.Parent=row
    btn.MouseButton1Click:Connect(function()
        S[key] = not S[key]
        local on = S[key]
        tf.BackgroundColor3 = on and C.ton or C.tof
        TweenService:Create(kn,TweenInfo.new(0.12),{
            Position = on and UDim2.new(1,-18,0.5,-8) or UDim2.new(0,2,0.5,-8)
        }):Play()
        if cb then cb(on) end
    end)
end

local function Slider(pan, lbl, key, mn, mx, suf, cb)
    local row = Instance.new("Frame")
    row.Size             = UDim2.new(1,0,0,46)
    row.BackgroundColor3 = C.row
    row.BorderSizePixel  = 0
    row.LayoutOrder      = O()
    row.Parent           = pan
    Instance.new("UICorner",row).CornerRadius = UDim.new(0,6)

    local l = Instance.new("TextLabel")
    l.Size=UDim2.new(0.6,0,0,18); l.Position=UDim2.new(0,8,0,4)
    l.BackgroundTransparency=1; l.Text=lbl; l.TextColor3=C.gt
    l.TextSize=11; l.Font=Enum.Font.Gotham
    l.TextXAlignment=Enum.TextXAlignment.Left; l.Parent=row

    local vl = Instance.new("TextLabel")
    vl.Size=UDim2.new(0.35,0,0,18); vl.Position=UDim2.new(0.62,0,0,4)
    vl.BackgroundTransparency=1
    vl.Text=tostring(S[key])..(suf or "")
    vl.TextColor3=C.pa; vl.TextSize=11; vl.Font=Enum.Font.GothamBold
    vl.TextXAlignment=Enum.TextXAlignment.Right; vl.Parent=row

    local tr = Instance.new("Frame")
    tr.Size=UDim2.new(1,-16,0,5); tr.Position=UDim2.new(0,8,0,30)
    tr.BackgroundColor3=C.pd; tr.BorderSizePixel=0; tr.Parent=row
    Instance.new("UICorner",tr).CornerRadius=UDim.new(1,0)

    local fi = Instance.new("Frame")
    local p0 = (S[key]-mn)/(mx-mn)
    fi.Size=UDim2.new(p0,0,1,0); fi.BackgroundColor3=C.pa
    fi.BorderSizePixel=0; fi.Parent=tr
    Instance.new("UICorner",fi).CornerRadius=UDim.new(1,0)

    local sb = Instance.new("TextButton")
    sb.Size=UDim2.new(1,0,1,0); sb.BackgroundTransparency=1; sb.Text=""; sb.Parent=tr

    local slid=false
    sb.MouseButton1Down:Connect(function() slid=true end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 then slid=false end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if slid and i.UserInputType==Enum.UserInputType.MouseMovement then
            local rx = math.clamp((i.Position.X - tr.AbsolutePosition.X)/tr.AbsoluteSize.X,0,1)
            local val= math.floor(mn + rx*(mx-mn))
            S[key]=val; fi.Size=UDim2.new(rx,0,1,0)
            vl.Text=tostring(val)..(suf or "")
            if cb then cb(val) end
        end
    end)
end

local function Dropdown(pan, lbl, key, opts, cb)
    local row = Instance.new("Frame")
    row.Size=UDim2.new(1,0,0,30); row.BackgroundColor3=C.row
    row.BorderSizePixel=0; row.LayoutOrder=O(); row.Parent=pan
    Instance.new("UICorner",row).CornerRadius=UDim.new(0,6)

    local l=Instance.new("TextLabel")
    l.Size=UDim2.new(0.5,0,1,0); l.Position=UDim2.new(0,8,0,0)
    l.BackgroundTransparency=1; l.Text=lbl; l.TextColor3=C.gt
    l.TextSize=11; l.Font=Enum.Font.Gotham
    l.TextXAlignment=Enum.TextXAlignment.Left; l.Parent=row

    local cur=Instance.new("TextButton")
    cur.Size=UDim2.new(0.44,0,0,22); cur.Position=UDim2.new(0.53,0,0.5,-11)
    cur.BackgroundColor3=C.pm; cur.TextColor3=C.wh
    cur.Text=S[key].." ▾"; cur.TextSize=11; cur.Font=Enum.Font.Gotham
    cur.BorderSizePixel=0; cur.Parent=row
    Instance.new("UICorner",cur).CornerRadius=UDim.new(0,5)

    local exp=false; local dl
    cur.MouseButton1Click:Connect(function()
        exp=not exp
        if dl then dl:Destroy(); dl=nil end
        if not exp then return end
        dl=Instance.new("Frame")
        dl.Size=UDim2.new(0,130,0,#opts*24+4)
        dl.Position=UDim2.new(1,-138,1,2)
        dl.BackgroundColor3=C.pd; dl.BorderSizePixel=0; dl.ZIndex=12; dl.Parent=row
        Instance.new("UICorner",dl).CornerRadius=UDim.new(0,6)
        local ll=Instance.new("UIListLayout"); ll.SortOrder=Enum.SortOrder.LayoutOrder; ll.Parent=dl
        for i,opt in ipairs(opts) do
            local ob=Instance.new("TextButton")
            ob.Size=UDim2.new(1,0,0,24)
            ob.BackgroundColor3=opt==S[key] and C.pm or C.pd
            ob.TextColor3=C.wh; ob.Text=opt; ob.TextSize=11
            ob.Font=Enum.Font.Gotham; ob.BorderSizePixel=0
            ob.LayoutOrder=i; ob.ZIndex=13; ob.Parent=dl
            ob.MouseButton1Click:Connect(function()
                S[key]=opt; cur.Text=opt.." ▾"
                dl:Destroy(); dl=nil; exp=false
                if cb then cb(opt) end
            end)
        end
    end)
end

local function KBPick(pan, lbl, key)
    local row=Instance.new("Frame")
    row.Size=UDim2.new(1,0,0,30); row.BackgroundColor3=C.row
    row.BorderSizePixel=0; row.LayoutOrder=O(); row.Parent=pan
    Instance.new("UICorner",row).CornerRadius=UDim.new(0,6)

    local l=Instance.new("TextLabel")
    l.Size=UDim2.new(0.55,0,1,0); l.Position=UDim2.new(0,8,0,0)
    l.BackgroundTransparency=1; l.Text=lbl; l.TextColor3=C.gt
    l.TextSize=11; l.Font=Enum.Font.Gotham
    l.TextXAlignment=Enum.TextXAlignment.Left; l.Parent=row

    local kb=Instance.new("TextButton")
    kb.Size=UDim2.new(0.38,0,0,22); kb.Position=UDim2.new(0.59,0,0.5,-11)
    kb.BackgroundColor3=C.pm; kb.TextColor3=C.wh
    kb.Text=tostring(S[key]):gsub("Enum.KeyCode.","")
    kb.TextSize=11; kb.Font=Enum.Font.GothamBold; kb.BorderSizePixel=0; kb.Parent=row
    Instance.new("UICorner",kb).CornerRadius=UDim.new(0,5)

    local list=false
    kb.MouseButton1Click:Connect(function()
        list=true; kb.Text="..."; kb.BackgroundColor3=Color3.fromRGB(200,100,50)
    end)
    UserInputService.InputBegan:Connect(function(i,gp)
        if not list then return end
        if i.UserInputType==Enum.UserInputType.Keyboard then
            S[key]=i.KeyCode
            kb.Text=tostring(i.KeyCode):gsub("Enum.KeyCode.","")
            kb.BackgroundColor3=C.pm; list=false
        end
    end)
end

