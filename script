RebuildRainbowCache = function(char)
    BodyCache={}; WeaponCache={}
    if not char then return end
    local tool=char:FindFirstChildWhichIsA("Tool")
    for _,p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") and p.Name~="HumanoidRootPart" then
            if tool and p:IsDescendantOf(tool) then
                table.insert(WeaponCache,p)
            else
                table.insert(BodyCache,p)
            end
        end
    end
end

-- ============================================================
-- BIG HEADS — Motor6D scale (donma yok)
-- ============================================================
local OrigHeadSize = Vector3.new(2,1,1)

local function ApplyBigHeads()
    local char=LP.Character; if not char then return end
    local head=char:FindFirstChild("Head"); if not head then return end
    if S.big_heads then
        local sc=S.big_head_scale
        -- Sadece head.Size'ı değiştir ama Humanoid'e dokunma
        -- Önce mevcut boyutu kaydet, sonra uygula
        head.Size=Vector3.new(sc, sc, sc)
        -- Motor6D C0 offset düzeltmesi (başın gövdeye bağlandığı joint)
        local neck = char:FindFirstChild("Neck",true)
             or (char:FindFirstChild("UpperTorso") and char.UpperTorso:FindFirstChild("Neck"))
             or (char:FindFirstChild("Torso") and char.Torso:FindFirstChild("Neck"))
        if neck and neck:IsA("Motor6D") then
            -- Orijinal offset'i scale'e göre yukarı taşı (float etmesin)
            local baseY = 1 + sc * 0.5
            neck.C0 = CFrame.new(0, baseY, 0) * CFrame.Angles(-math.pi/2, 0, math.pi)
        end
    else
        head.Size = OrigHeadSize
        local neck = char:FindFirstChild("Neck",true)
             or (char:FindFirstChild("UpperTorso") and char.UpperTorso:FindFirstChild("Neck"))
             or (char:FindFirstChild("Torso") and char.Torso:FindFirstChild("Neck"))
        if neck and neck:IsA("Motor6D") then
            neck.C0 = CFrame.new(0, 1, 0) * CFrame.Angles(-math.pi/2, 0, math.pi)
        end
    end
end

-- ============================================================
-- HIZ — ramp bypass (sunucu ışınlamasına karşı)
-- Strateji: walkspeed'i hedefe kademeli yükselt, ani değişim yok
-- ============================================================
local CurrentSpeed = 16
local SpeedRampConn

local function StartSpeedRamp(target)
    if SpeedRampConn then SpeedRampConn:Disconnect() end
    SpeedRampConn = RunService.Heartbeat:Connect(function(dt)
        local char=LP.Character; if not char then return end
        local hum=char:FindFirstChildOfClass("Humanoid"); if not hum then return end
        -- Kademeli artış: saniyede max 8 birim
        if CurrentSpeed < target then
            CurrentSpeed = math.min(CurrentSpeed + 8 * dt, target)
        elseif CurrentSpeed > target then
            CurrentSpeed = math.max(CurrentSpeed - 8 * dt, target)
        end
        hum.WalkSpeed = CurrentSpeed
    end)
end

local function StopSpeedRamp()
    if SpeedRampConn then SpeedRampConn:Disconnect(); SpeedRampConn=nil end
    CurrentSpeed=16
    local char=LP.Character
    if char then
        local hum=char:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed=16 end
    end
end

