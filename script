-- ============================================================
-- UTILITY
-- ============================================================
local function WorldToViewport(pos)
    local screen, vis = Camera:WorldToViewportPoint(pos)
    return Vector2.new(screen.X, screen.Y), vis, screen.Z
end

local function IsVisible(origin, target)
    local ray = Ray.new(origin, (target - origin).Unit * 4000)
    local hit = Workspace:FindPartOnRayWithIgnoreList(ray, {LChar})
    return hit == nil or hit:IsDescendantOf(Players:GetPlayerFromCharacter(hit.Parent) and hit.Parent or Workspace)
end

local function GetAllEnemies()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                table.insert(list, p)
            end
        end
    end
    return list
end

local function GetBoundingBox(char)
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil, nil end
    local min = hrp.Position - Vector3.new(2.5, 3.5, 0)
    local max = hrp.Position + Vector3.new(2.5, 3.5, 0)
    return min, max
end

