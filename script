--  SPEED / MEVLANA / GHOST / HITBOX / BHOP
--  NOCLIP / ANTI-AFK / FOV
-- ══════════════════════════════════════════════

local function speedApply()
    local h = getHum(lp)
    if h then h.WalkSpeed = cfg.speed and cfg.speed_val or 16 end
end

local mevlanaAngle = 0
local mevlanaConn
local function mevlanaToggle()
    if mevlanaConn then mevlanaConn:Disconnect(); mevlanaConn = nil end
    if not cfg.mevlana then return end
    mevlanaConn = RunService.Heartbeat:Connect(function(dt)
        local c    = lp.Character
        local root = c and c:FindFirstChild("HumanoidRootPart")
        if not root then return end
        mevlanaAngle = mevlanaAngle + cfg.mevlana_spd * dt
        root.CFrame = CFrame.new(root.Position)
            * CFrame.Angles(0, math.rad(mevlanaAngle), 0)
    end)
end

local lastAura = 0
local function killAuraUpdate()
    if not cfg.killaura then return end
    local now = tick()
    if now - lastAura < cfg.aura_rate then return end
    lastAura = now
    local selfRoot = getHRP(lp)
    if not selfRoot then return end
    for _, p in ipairs(enemies()) do
        local tr = getHRP(p)
        if tr and (selfRoot.Position - tr.Position).Magnitude <= cfg.aura_radius then
            local h = getHum(p)
            if h and h.Health > 0 then
                pcall(function() h:TakeDamage(cfg.aura_dmg) end)
            end
        end
    end
end

local function ghostApply()
    local c = lp.Character
    if not c then return end
    for _, part in ipairs(c:GetDescendants()) do
        if part:IsA("BasePart") then
            part.LocalTransparencyModifier = cfg.ghost and cfg.ghost_alpha or 0
        end
    end
end

local function hitboxApply()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == lp then continue end
        local c = p.Character
        if not c then continue end
        local hrp = c:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.Size        = cfg.hitbox
                and Vector3.new(cfg.hitbox_sz, cfg.hitbox_sz, cfg.hitbox_sz)
                or  Vector3.new(2, 2, 1)
            hrp.Transparency = cfg.hitbox and 0.5 or 1
        end
    end
end

local bhopConn
local function bhopToggle()
    if bhopConn then bhopConn:Disconnect(); bhopConn = nil end
    if not cfg.bhop then return end
    bhopConn = RunService.Heartbeat:Connect(function()
        local c    = lp.Character
        local h    = c and c:FindFirstChildOfClass("Humanoid")
        local root = c and c:FindFirstChild("HumanoidRootPart")
        if h and root then
            if math.abs(root.Velocity.Y) < 2 then h.Jump = true end
        end
    end)
end

local noclipConn
local function noclipToggle()
    if noclipConn then noclipConn:Disconnect(); noclipConn = nil end
    if not cfg.noclip then
        local c = lp.Character
        if c then
            for _, p in ipairs(c:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = true end
            end
        end
        return
    end
    noclipConn = RunService.Stepped:Connect(function()
        local c = lp.Character
        if c then
            for _, p in ipairs(c:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end
    end)
end

local afkConn
local function afkToggle()
    if afkConn then afkConn:Disconnect(); afkConn = nil end
    if not cfg.antiafk then return end
    afkConn = RunService.Heartbeat:Connect(function()
        VirtualUser:Button2Down(Vector2.new(0, 0), cam.CFrame)
        VirtualUser:Button2Up(Vector2.new(0, 0), cam.CFrame)
    end)
end

local function fovApply()
    cam.FieldOfView = cfg.fov_change and cfg.fov_val or 70
end

