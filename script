-- Slider row — returns nothing, drag updates cfg live
local function addSlider(panel, label, cfgKey, mn, mx, suffix, transform, reverseTransform)
    local row = Instance.new("Frame", panel)
    row.Size            = UDim2.new(1, 0, 0, 52)
    row.BackgroundColor3= C.bg2
    row.BorderSizePixel = 0
    row.LayoutOrder     = nextOrder()
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 7)

    local displayVal = reverseTransform and reverseTransform(cfg[cfgKey]) or cfg[cfgKey]

    local nameLbl = Instance.new("TextLabel", row)
    nameLbl.Size                = UDim2.new(0.65, 0, 0, 20)
    nameLbl.Position            = UDim2.new(0, 10, 0, 6)
    nameLbl.BackgroundTransparency = 1
    nameLbl.Font                = Enum.Font.Gotham
    nameLbl.TextSize            = 12
    nameLbl.TextColor3          = C.gray
    nameLbl.TextXAlignment      = Enum.TextXAlignment.Left
    nameLbl.Text                = label

    local valLbl = Instance.new("TextLabel", row)
    valLbl.Size                = UDim2.new(0.32, 0, 0, 20)
    valLbl.Position            = UDim2.new(0.68, 0, 0, 6)
    valLbl.BackgroundTransparency = 1
    valLbl.Font                = Enum.Font.GothamBold
    valLbl.TextSize            = 12
    valLbl.TextColor3          = C.orange
    valLbl.TextXAlignment      = Enum.TextXAlignment.Right
    valLbl.Text                = tostring(math.floor(displayVal)) .. (suffix or "")

    -- Track
    local track = Instance.new("Frame", row)
    track.Size            = UDim2.new(1, -20, 0, 6)
    track.Position        = UDim2.new(0, 10, 0, 34)
    track.BackgroundColor3= C.bg3
    track.BorderSizePixel = 0
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

    -- Fill
    local pct0 = math.clamp((displayVal - mn) / (mx - mn), 0, 1)
    local fill = Instance.new("Frame", track)
    fill.Size            = UDim2.new(pct0, 0, 1, 0)
    fill.BackgroundColor3= C.purple
    fill.BorderSizePixel = 0
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local fillGrad = Instance.new("UIGradient", fill)
    fillGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, C.purple),
        ColorSequenceKeypoint.new(1, C.orange),
    })

    -- Knob
    local knob = Instance.new("Frame", track)
    knob.Size            = UDim2.new(0, 14, 0, 14)
    knob.Position        = UDim2.new(pct0, -7, 0.5, -7)
    knob.BackgroundColor3= C.white
    knob.BorderSizePixel = 0
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local knobStroke = Instance.new("UIStroke", knob)
    knobStroke.Color     = C.orange
    knobStroke.Thickness = 1.5

    -- Interaction
    local sliding = false

    local function updateFromX(absX)
        local abs   = track.AbsolutePosition
        local sz    = track.AbsoluteSize
        local pct   = math.clamp((absX - abs.X) / sz.X, 0, 1)
        local rawV  = mn + (mx - mn) * pct
        local dispV = math.floor(rawV)

        fill.Size     = UDim2.new(pct, 0, 1, 0)
        knob.Position = UDim2.new(pct, -7, 0.5, -7)
        valLbl.Text   = tostring(dispV) .. (suffix or "")

        if transform then
            cfg[cfgKey] = transform(rawV)
        else
            cfg[cfgKey] = dispV
        end
    end

    local trackBtn = Instance.new("TextButton", track)
    trackBtn.Size               = UDim2.new(1, 0, 3, -6)
    trackBtn.Position           = UDim2.new(0, 0, 0, -8)
    trackBtn.BackgroundTransparency = 1
    trackBtn.Text               = ""

    trackBtn.MouseButton1Down:Connect(function(x, _)
        sliding = true
        TweenService:Create(knob, TweenInfo.new(0.08), {
            Size = UDim2.new(0, 18, 0, 18),
            Position = UDim2.new(knob.Position.X.Scale, -9, 0.5, -9),
        }):Play()
        updateFromX(x)
    end)

    UserInputService.InputChanged:Connect(function(inp)
        if sliding and inp.UserInputType == Enum.UserInputType.MouseMovement then
            updateFromX(inp.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 and sliding then
            sliding = false
            TweenService:Create(knob, TweenInfo.new(0.08), {
                Size = UDim2.new(0, 14, 0, 14),
                Position = UDim2.new(knob.Position.X.Scale, -7, 0.5, -7),
            }):Play()
        end
    end)
end

