-- ============================================================
-- ONE SHOT — Tool.Activated hook (her silah değişiminde yeniden bağla)
-- ============================================================
local OneShotConns = {}

local function HookOneShotTool(tool)
    -- Zaten hooklandıysa geç
    for _, c in ipairs(OneShotConns) do
        if c[1] == tool then return end
    end
    -- RemoteEvent bul (hit/damage/fire)
    local function FindRemote(t)
        for _,v in ipairs(t:GetDescendants()) do
            if v:IsA("RemoteEvent") then
                local n=v.Name:lower()
                if n:find("hit") or n:find("damage") or n:find("fire") or n:find("shoot") then
                    return v
                end
            end
        end
        -- ReplicatedStorage'da ara
        local RE=game:GetService("ReplicatedStorage")
        for _,v in ipairs(RE:GetDescendants()) do
            if v:IsA("RemoteEvent") then
                local n=v.Name:lower()
                if n:find("hit") or n:find("damage") or n:find("fire") or n:find("shoot") then
                    return v
                end
            end
        end
        return nil
    end

    -- Activated'da direkt karşıdaki oyuncunun HP'sini 0'a çekmeyi dene
    -- (RemoteEvent yoksa Humanoid.Health = 0 ile fallback)
    local conn = tool.Activated:Connect(function()
        if not S.one_shot then return end
        -- Crosshair'daki hedefe damage ver
        local target = GetTarget()
        if not target then return end
        local targetChar = target.Parent
        local hum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
        if hum then
            -- Client-side Humanoid.Health yazımı (bazı oyunlarda çalışır)
            -- Çalışmazsa RemoteEvent hook fallback
            hum.Health = 0
        end
    end)
    table.insert(OneShotConns, {tool, conn})
end

-- Remote hook fallback (hookfunction varsa)
local function HookOneShotRemote()
    if not hookfunction then return end
    local RE=game:GetService("ReplicatedStorage")
    local remote
    for _,v in ipairs(RE:GetDescendants()) do
        if v:IsA("RemoteEvent") then
            local n=v.Name:lower()
            if n:find("hit") or n:find("damage") or n:find("fire") or n:find("shoot") then
                remote=v; break
            end
        end
    end
    if not remote then return end
    local orig=hookfunction(remote.FireServer, newcclosure(function(self,...)
        if S.one_shot then
            local args={...}
            for i,v in ipairs(args) do
                if type(v)=="number" and v>0 and v<500 then
                    args[i]=9999; break
                end
            end
            return orig(self,table.unpack(args))
        end
        return orig(self,...)
    end))
end
pcall(HookOneShotRemote)

-- Silah değişimini izle
local function WatchTools(char)
    -- Mevcut araçları hook'la
    for _,v in ipairs(char:GetChildren()) do
        if v:IsA("Tool") then HookOneShotTool(v) end
    end
    char.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then
            task.wait(0.1)
            HookOneShotTool(child)
            RebuildRainbowCache(char)
        end
    end)
    char.ChildRemoved:Connect(function(child)
        if child:IsA("Tool") then
            RebuildRainbowCache(char)
        end
    end)
end

