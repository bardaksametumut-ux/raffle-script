-- ═══════════════════════════════════════
-- ESP RENDER LOOP
-- ═══════════════════════════════════════
local espObjects = {}

local function updateESP()
    -- Cleanup dead objects
    for player, objs in pairs(espObjects) do
        if not Players:FindFirstChild(player.Name) then
            for _, obj in pairs(objs) do pcall(function() obj:Remove() end) end
            espObjects[player] = nil
        end
    end

    if not Config.ESP.Enabled then
        for _, objs in pairs(espObjects) do
            for _, obj in pairs(objs) do pcall(function() obj.Visible = false end) end
        end
        return
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")

            if hrp and hum and hum.Health > 0 then
                local dist = (hrp.Position - Camera.CFrame.Position).Magnitude
                if dist <= Config.ESP.Distance.MaxRange then
                    if not espObjects[player] then espObjects[player] = {} end
                    local objs = espObjects[player]

                    -- Box
                    if Config.ESP.Box.Enabled then
                        if not objs.Box then
                            objs.Box = Drawing.new("Square")
                        end
                        local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                        objs.Box.Visible = onScreen
                        if onScreen then
                            local size = 300 / dist
                            objs.Box.Size = Vector2.new(size * 1.5, size * 2)
                            objs.Box.Position = Vector2.new(screenPos.X - objs.Box.Size.X/2, screenPos.Y - objs.Box.Size.Y/2)
                            objs.Box.Color = Config.ESP.Box.Color
                            objs.Box.Thickness = Config.ESP.Box.Thickness
                        end
                    elseif objs.Box then objs.Box.Visible = false end

                    -- Name
                    if Config.ESP.Name.Enabled then
                        if not objs.Name then
                            objs.Name = Drawing.new("Text")
                            objs.Name.Center = true
                            objs.Name.Outline = true
                        end
                        local head = char:FindFirstChild("Head")
                        if head then
                            local sp, os = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1.5, 0))
                            objs.Name.Visible = os
                            if os then
                                objs.Name.Position = Vector2.new(sp.X, sp.Y)
                                objs.Name.Text = string.format("%s [%d]", player.Name, math.floor(dist))
                                objs.Name.Color = Config.ESP.Name.Color
                                objs.Name.Size = Config.ESP.Name.Size
                            end
                        end
                    elseif objs.Name then objs.Name.Visible = false end
                else
                    if espObjects[player] then
                        for _, obj in pairs(espObjects[player]) do pcall(function() obj.Visible = false end) end
                    end
                end
            end
        end
    end
end

-- ═══════════════════════════════════════
-- AIMBOT LOOP
-- ═══════════════════════════════════════
local function getClosestTarget()
    local closest, minDist = nil, Config.Aimbot.FOV
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if Config.Aimbot.TeamCheck and player.Team == LocalPlayer.Team then continue end
            local char = player.Character
            local part = char and char:FindFirstChild(Config.Aimbot.TargetPart)
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if part and hum and hum.Health > 0 then
                local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    local mousePos = UserInputService:GetMouseLocation()
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    if dist < minDist then
                        minDist = dist
                        closest = part
                    end
                end
            end
        end
    end
    return closest
end

local function updateAimbot()
    if not Config.Aimbot.Enabled then return end
    local held = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
        or UserInputService:IsKeyDown(Config.Aimbot.Keybind)
    if not held then return end

    local target = getClosestTarget()
    if target then
        local smooth = math.clamp(Config.Aimbot.Smoothness / 100, 0.01, 1)
        local goal = CFrame.lookAt(Camera.CFrame.Position, target.Position)
        Camera.CFrame = Camera.CFrame:Lerp(goal, smooth)
    end
end

-- ═══════════════════════════════════════
-- ABSURD FEATURES LOOP
-- ═══════════════════════════════════════
local rainbowHue = 0
local mevlanaAngle = 0

local function updateAbsurd(dt)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not (char and hrp and hum) then return end

    -- Rainbow Body
    if Config.Absurd.RainbowBody then
        rainbowHue = (rainbowHue + dt * 0.5) % 1
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart"
               and not part:FindFirstAncestorWhichIsA("Tool") then
                part.Color = Color3.fromHSV(rainbowHue, 1, 1)
            end
        end
    end

    -- Rainbow Weapon
    if Config.Absurd.RainbowWeapon then
        for _, tool in ipairs(char:GetChildren()) do
            if tool:IsA("Tool") then
                for _, part in ipairs(tool:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.Color = Color3.fromHSV(rainbowHue, 1, 1)
                    end
                end
            end
        end
    end

    -- Big Heads
    if Config.Absurd.BigHeads then
        local head = char:FindFirstChild("Head")
        if head and head:IsA("MeshPart") then
            head.Mesh.Scale = Vector3.new(Config.Absurd.HeadScale, Config.Absurd.HeadScale, Config.Absurd.HeadScale)
        end
    end

    -- Super Speed / Jump (client prediction only)
    if Config.Absurd.SuperSpeed then
        hum.WalkSpeed = Config.Absurd.SpeedValue
    end
    if Config.Absurd.SuperJump then
        hum.JumpPower = Config.Absurd.JumpPower
    end

    -- 3rd Person
    if Config.Absurd.ThirdPerson then
        LocalPlayer.CameraMode = Enum.CameraMode.Classic
        LocalPlayer.CameraMinZoomDistance = 8
    end

    -- Mevlana Spin (local visual only)
    if Config.Absurd.Mevlana and hrp then
        mevlanaAngle = mevlanaAngle + dt * Config.Absurd.MevlanaSpeed
        hrp.CFrame = hrp.CFrame * CFrame.Angles(0, mevlanaAngle * dt, 0)
    end
end

