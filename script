local MevlanaConn
local function SetMevlana(on)
    if MevlanaConn then MevlanaConn:Disconnect(); MevlanaConn = nil end
    if not on then return end
    MevlanaConn = RunService.Heartbeat:Connect(function(dt)
        local char = LP.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            -- Network ownership trick: direkt CFrame set
            hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(720 * dt), 0)
        end
    end)
end

-- ============================================================
-- MAIN LOOP
-- ============================================================
RunService.RenderStepped:Connect(function(dt)
    RainbowHue   = (RainbowHue + dt * 0.4) % 1
    RainbowFrame = RainbowFrame + 1

    -- ESP
    RenderESP()

    -- FOV dairesi
    if S.aim_enabled and S.aim_draw_fov then
        local vp = Camera.ViewportSize
        FovCircle.Visible  = true
        FovCircle.Position = Vector2.new(vp.X/2, vp.Y/2)
        FovCircle.Radius   = S.aim_fov
    else FovCircle.Visible = false end

    -- Aimbot — her frame kamera güncelle (lerp doğru çalışıyor)
    if S.aim_enabled and AimActive then
        local target = GetTarget()
        if target then
            local tPos = target.Position
            if S.aim_prediction then
                local vel = target.AssemblyLinearVelocity or Vector3.zero
                tPos = tPos + vel * (S.aim_prediction_ms / 1000)
            end
            local smooth = S.aim_smoothness / 100  -- 1-100 → 0.01-1.0
            local lookAt = CFrame.new(Camera.CFrame.Position, tPos)
            Camera.CFrame = Camera.CFrame:Lerp(lookAt, smooth)
        end
    end

    -- Rainbow — sadece 8 frame'de bir (donma fix)
    if RainbowFrame % 8 == 0 then
        local rcol = Color3.fromHSV(RainbowHue, 1, 1)
        if S.rainbow_body then
            for _, p in ipairs(BodyPartCache) do
                if p and p.Parent then p.Color = rcol end
            end
        end
        if S.rainbow_weapon then
            for _, p in ipairs(WeaponPartCache) do
                if p and p.Parent then p.Color = rcol end
            end
        end
    end

    -- Big heads
    if S.big_heads then ApplyBigHeads() end
end)

RunService.Heartbeat:Connect(function()
    ApplyStats()
end)

