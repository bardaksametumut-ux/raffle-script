local function Toggle(panel, label, stateKey, callback)
    local row = Instance.new("Frame")
    row.Size             = UDim2.new(1, 0, 0, 32)
    row.BackgroundColor3 = Color3.fromRGB(18, 8, 32)
    row.BorderSizePixel  = 0
