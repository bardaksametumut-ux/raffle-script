-- ══ MİNİHARİTA ══
local trackerPool = {}
local MAP_SIZE    = 150
local MAP_PAD     = 10

local function trackerClear()
    for _, d in ipairs(trackerPool) do d:Remove() end
    trackerPool = {}
end

local function trackerDraw(typ, props)
    local d = Drawing.new(typ)
    for k, v in pairs(props) do d[k] = v end
    trackerPool[#trackerPool+1] = d
    return d
end

local function trackerUpdate()
    trackerClear()
    if not cfg.tracker then return end
    local vp  = cam.ViewportSize
    local mx  = vp.X - MAP_SIZE - MAP_PAD
    local my  = vp.Y - MAP_SIZE - MAP_PAD
    local mid = Vector2.new(mx + MAP_SIZE*0.5, my + MAP_SIZE*0.5)
    trackerDraw("Square", {Visible=true, Position=Vector2.new(mx,my),
        Size=Vector2.new(MAP_SIZE,MAP_SIZE),
        Color=Color3.fromRGB(10,10,15), Filled=true,
        Thickness=0, Transparency=0.55})
    trackerDraw("Square", {Visible=true, Position=Vector2.new(mx,my),
        Size=Vector2.new(MAP_SIZE,MAP_SIZE),
        Color=Color3.fromRGB(220,40,55), Filled=false, Thickness=1.2})
    trackerDraw("Text",   {Visible=true, Text="RAZE MAP",
        Position=Vector2.new(mx+4,my+2),
        Size=10, Color=Color3.fromRGB(220,40,55), Outline=true})
    trackerDraw("Circle", {Visible=true, Position=mid, Radius=4,
        Color=Color3.new(1,1,1), Filled=true, Thickness=0})
    local selfRoot = getHRP(lp)
    if not selfRoot then return end
    local SCALE = MAP_SIZE/500
    for _, p in ipairs(enemies()) do
        local tr = getHRP(p)
        if not tr then continue end
        local rel  = tr.Position - selfRoot.Position
        local dotX = math.clamp(rel.X*SCALE, -MAP_SIZE*0.5+6, MAP_SIZE*0.5-6)
        local dotZ = math.clamp(rel.Z*SCALE, -MAP_SIZE*0.5+6, MAP_SIZE*0.5-6)
        local dp   = Vector2.new(mid.X+dotX, mid.Y+dotZ)
        trackerDraw("Circle", {Visible=true, Position=dp, Radius=4,
            Color=cfg.esp_color, Filled=true, Thickness=0})
        trackerDraw("Text",   {Visible=true, Text=p.Name:sub(1,8),
            Position=Vector2.new(dp.X+5, dp.Y-7),
            Size=9, Color=Color3.new(1,1,1), Outline=true})
    end
end

