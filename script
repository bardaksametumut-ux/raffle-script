-- ══════════════════════════════════════════════
--  TAB BUTTONS + SWITCHING
-- ══════════════════════════════════════════════

local activeTab = 1
local tabBtns   = {}

local function switchTab(i)
    activeTab = i
    -- Slide indicator
    TweenService:Create(tabIndicator, TweenInfo.new(0.22, Enum.EasingStyle.Quad), {
        Position = UDim2.new((i-1) / #TAB_NAMES, 1, 1, -2),
    }):Play()

    for idx, btn in ipairs(tabBtns) do
        local active = idx == i
        TweenService:Create(btn, TweenInfo.new(0.15), {
            BackgroundColor3 = active and C.bg3 or C.bg1,
        }):Play()
        btn.TextColor3 = active and C.white or C.gray
    end

    for idx, pan in ipairs(panels) do
        if idx == i then
            pan.Visible = true
            pan.Position = UDim2.new(0.05, 0, 0, 0)
            pan.BackgroundTransparency = 1
            TweenService:Create(pan, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {
                Position = UDim2.new(0, 0, 0, 0),
            }):Play()
        else
            pan.Visible = false
        end
    end
end

for i, name in ipairs(TAB_NAMES) do
    local btn = Instance.new("TextButton", tabBar)
    btn.Size            = UDim2.new(1/#TAB_NAMES, -1, 1, 0)
    btn.BackgroundColor3= i == 1 and C.bg3 or C.bg1
    btn.BorderSizePixel = 0
    btn.Font            = Enum.Font.GothamBold
    btn.TextSize        = 12
    btn.TextColor3      = i == 1 and C.white or C.gray
    btn.Text            = name
    btn.LayoutOrder     = i

    btn.MouseButton1Click:Connect(function()
        switchTab(i)
    end)

    tabBtns[i] = btn
end

switchTab(1)

-- ══════════════════════════════════════════════
--  MENU OPEN / CLOSE (INSERT key)
-- ══════════════════════════════════════════════

local menuOpen = false

local function setMenu(open)
    menuOpen = open
    if open then
        root.Visible = true
        root.BackgroundTransparency = 1
        TweenService:Create(root, TweenInfo.new(0.22, Enum.EasingStyle.Quad), {
            BackgroundTransparency = 0,
        }):Play()
        -- Pop in scale effect via Position shift
        root.Position = UDim2.new(
            root.Position.X.Scale, root.Position.X.Offset,
            root.Position.Y.Scale, root.Position.Y.Offset + 8)
        TweenService:Create(root, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Position = UDim2.new(
                root.Position.X.Scale, root.Position.X.Offset,
                root.Position.Y.Scale, root.Position.Y.Offset - 8),
        }):Play()
    else
        TweenService:Create(root, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {
            BackgroundTransparency = 1,
        }):Play()
        task.delay(0.16, function() root.Visible = false end)
    end
end

