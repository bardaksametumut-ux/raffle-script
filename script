    Instance.new("UICorner", hoverFrame).CornerRadius = UDim.new(0, 7)

    local lbl = Instance.new("TextLabel", row)
    lbl.Size                = UDim2.new(1, -70, 1, 0)
    lbl.Position            = UDim2.new(0, 12, 0, 0)
