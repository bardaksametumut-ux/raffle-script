-- ══ INPUT ══
local function applyToggleSideEffects(key)
    if key=="speed"      then speedApply()    end
    if key=="bhop"       then bhopToggle()    end
    if key=="noclip"     then noclipToggle()  end
    if key=="mevlana"    then mevlanaToggle() end
    if key=="antiafk"    then afkToggle()     end
    if key=="fov_change" then fovApply()      end
end

UserInputService.InputBegan:Connect(function(inp, gpe)
    if inp.KeyCode == Enum.KeyCode.Insert then
        menu.open = not menu.open; menuRender(); return
    end
    if inp.KeyCode == Enum.KeyCode.F1 then cfg.esp=not cfg.esp; menuRender()
    elseif inp.KeyCode == Enum.KeyCode.F2 then cfg.aimbot=not cfg.aimbot; menuRender()
    elseif inp.KeyCode == Enum.KeyCode.F3 then cfg.speed=not cfg.speed; speedApply(); menuRender()
    elseif inp.KeyCode == Enum.KeyCode.F4 then cfg.mevlana=not cfg.mevlana; mevlanaToggle(); menuRender()
    elseif inp.KeyCode == Enum.KeyCode.F5 then cfg.noclip=not cfg.noclip; noclipToggle(); menuRender()
    elseif inp.KeyCode == Enum.KeyCode.F6 then cfg.killaura=not cfg.killaura; menuRender()
    end
    if not menu.open then return end
    if inp.UserInputType == Enum.UserInputType.MouseButton1 then
        local mx, my = inp.Position.X, inp.Position.Y
        if mx>=menu.x and mx<=menu.x+menu.w
           and my>=menu.y and my<=menu.y+34 then
            isDrag=true; dragSX=mx; dragSY=my
            menuStartX=menu.x; menuStartY=menu.y; return
        end
        local tabW = menu.w/#menu.tabs
        if my>=menu.y+36 and my<=menu.y+64 then
            for i=1,#menu.tabs do
                local tx=menu.x+(i-1)*tabW
                if mx>=tx and mx<=tx+tabW then
                    menu.tab=i; menuRender(); return
                end
            end
        end
        if menu.tab==1 then
            local boneY = menu.y+74+28+34+38*4
            if mx>=menu.x+12 and mx<=menu.x+menu.w-12
               and my>=boneY and my<=boneY+16 then
                cfg.aim_bone = cfg.aim_bone=="Head" and "HumanoidRootPart" or "Head"
                menuRender(); return
            end
        end
        local tabKeys  = tabToggles[menu.tab]
        local tidx     = 0
        for _, area in ipairs(toggleAreas) do
            tidx = tidx+1
            local k = tabKeys[tidx]
            if k and mx>=area.x and mx<=area.x+area.w
               and my>=area.y and my<=area.y+area.h then
                cfg[k]=not cfg[k]; applyToggleSideEffects(k); menuRender(); return
            end
        end
        for _, sl in ipairs(sliderAreas) do
            if mx>=sl.x and mx<=sl.x+sl.w
               and my>=sl.y and my<=sl.y+7 then
                local pct = (mx-sl.x)/sl.w
                local val = sl.min+(sl.max-sl.min)*pct
                if sl.key=="_aim_smooth" then
                    cfg.aim_smooth = 1-(val/100)
                elseif sl.key=="_ghost_alpha" then
                    cfg.ghost_alpha = val/100
                else
                    cfg[sl.key]=math.floor(val)
                    applyToggleSideEffects(sl.key)
                end
                menuRender(); return
            end
        end
    end
end)

UserInputService.InputChanged:Connect(function(inp)
    if isDrag and inp.UserInputType==Enum.UserInputType.MouseMovement then
        menu.x = menuStartX+(inp.Position.X-dragSX)
        menu.y = menuStartY+(inp.Position.Y-dragSY)
        menuRender()
    end
end)
UserInputService.InputEnded:Connect(function(inp)
    if inp.UserInputType==Enum.UserInputType.MouseButton1 then isDrag=false end
end)

