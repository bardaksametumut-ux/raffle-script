-- ============================================================
-- ONE SHOT
-- ============================================================
local function HookOneShot()
    if not hookfunction then return end
    local RE = game:GetService("ReplicatedStorage")
    local remote
    for _, v in ipairs(RE:GetDescendants()) do
        if v:IsA("RemoteEvent") then
            local n = v.Name:lower()
            if n:find("damage") or n:find("hit") or n:find("fire") or n:find("shoot") then
                remote = v; break
            end
        end
    end
    if not remote then return end
    local orig = hookfunction(remote.FireServer, newcclosure(function(self, ...)
        if S.one_shot then
            local args = {...}
            for i, v in ipairs(args) do
                if type(v) == "number" and v > 0 and v < 500 then
                    args[i] = 9999; break
                end
            end
            return orig(self, table.unpack(args))
        end
        return orig(self, ...)
    end))
end
pcall(HookOneShot)

