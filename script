-- ══ MEVLANA ══
local mevlanaAngle = 0
local mevlanaConn
local function mevlanaToggle()
    if mevlanaConn then mevlanaConn:Disconnect(); mevlanaConn = nil end
    if not cfg.mevlana then return end
    mevlanaConn = RunService.Heartbeat:Connect(function(dt)
        local c    = lp.Character
        local root = c and c:FindFirstChild("HumanoidRootPart")
        if not root then return end
        mevlanaAngle = mevlanaAngle + cfg.mevlana_spd * dt
        root.CFrame  = CFrame.new(root.Position)
            * CFrame.Angles(0, math.rad(mevlanaAngle), 0)
    end)
end

-- ══ KILL AURA ══
local lastAura = 0
local function killAuraUpdate()
    if not cfg.killaura then return end
    local now = tick()
    if now - lastAura < cfg.aura_rate then return end
    lastAura = now
    local selfRoot = getHRP(lp)
    if not selfRoot then return end
    for _, p in ipairs(enemies()) do
        local tr = getHRP(p)
        if tr and (selfRoot.Position - tr.Position).Magnitude <= cfg.aura_radius then
            local h = getHum(p)
            if h and h.Health > 0 then
                pcall(function() h:TakeDamage(cfg.aura_dmg) end)
            end
        end
    end
end

-- ══ GHOST ══
local function ghostApply()
    local c = lp.Character
    if not c then return end
    for _, part in ipairs(c:GetDescendants()) do
        if part:IsA("BasePart") then
            part.LocalTransparencyModifier = cfg.ghost and cfg.ghost_alpha or 0
        end
    end
end

-- ══ HİTBOX ══
local function hitboxApply()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == lp then continue end
        local c   = p.Character
        local hrp = c and c:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.Size         = cfg.hitbox
                and Vector3.new(cfg.hitbox_sz, cfg.hitbox_sz, cfg.hitbox_sz)
                or  Vector3.new(2, 2, 1)
            hrp.Transparency = cfg.hitbox and 0.5 or 1
        end
    end
end

