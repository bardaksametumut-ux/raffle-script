local AimActive = false
UserInputService.InputBegan:Connect(function(inp, gp)
    if gp then return end
    if inp.KeyCode == S.aim_key then AimActive = true end
end)
UserInputService.InputEnded:Connect(function(inp)
    if inp.KeyCode == S.aim_key then AimActive = false end
end)

local function GetTarget()
    local vp  = Camera.ViewportSize
    local cen = Vector2.new(vp.X/2, vp.Y/2)
    local best, bestD = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        local char = p.Character
        if not char then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local part = char:FindFirstChild(S.aim_target_part) or char:FindFirstChild("HumanoidRootPart")
        if not part then continue end
        local sc, vis = Camera:WorldToViewportPoint(part.Position)
        if not vis then continue end
        local sp = Vector2.new(sc.X, sc.Y)
        local d  = (sp - cen).Magnitude
        if d < S.aim_fov and d < bestD then
            bestD = d; best = part
        end
    end
    return best
end

-- ============================================================
-- RAINBOW — throttle ile (her 8 frame'de bir, donma yok)
-- ============================================================
local RainbowHue   = 0
local RainbowFrame = 0

-- Karakter parçalarını bir kez cache'le
local BodyPartCache   = {}
local WeaponPartCache = {}

local function RebuildRainbowCache(char)
    BodyPartCache   = {}
    WeaponPartCache = {}
    if not char then return end
    local tool = char:FindFirstChildWhichIsA("Tool")
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
            if tool and p:IsDescendantOf(tool) then
                table.insert(WeaponPartCache, p)
            else
                table.insert(BodyPartCache, p)
            end
        end
    end
end

LP.CharacterAdded:Connect(function(c)
    task.wait(1)
    RebuildRainbowCache(c)
end)
task.spawn(function()
    task.wait(1)
    RebuildRainbowCache(LP.Character)
end)

-- Silah değişince cache yenile
LP.CharacterAdded:Connect(function(c)
    c.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then
            task.wait(0.1)
            RebuildRainbowCache(c)
        end
    end)
    c.ChildRemoved:Connect(function(child)
        if child:IsA("Tool") then
