    lbl.TextColor3= GRAY_TEXT
    lbl.TextSize  = 12
    lbl.Font      = Enum.Font.Gotham
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent    = row

    local kb = Instance.new("TextButton")
    kb.Size             = UDim2.new(0.38, 0, 0, 24)
    kb.Position         = UDim2.new(0.59, 0, 0.5, -12)
    kb.BackgroundColor3 = PURPLE_MID
    kb.TextColor3       = WHITE
    kb.Text             = tostring(State[stateKey]):gsub("Enum.KeyCode.", "")
    kb.TextSize         = 12
    kb.Font             = Enum.Font.GothamBold
    kb.BorderSizePixel  = 0
    kb.Parent           = row
    Instance.new("UICorner", kb).CornerRadius = UDim.new(0, 5)

    local listening = false
    kb.MouseButton1Click:Connect(function()
        listening = true
        kb.Text = "..."
        kb.BackgroundColor3 = Color3.fromRGB(200, 100, 50)
    end)
    UserInputService.InputBegan:Connect(function(inp, gp)
        if not listening then return end
        if inp.UserInputType == Enum.UserInputType.Keyboard then
            State[stateKey] = inp.KeyCode
            kb.Text = tostring(inp.KeyCode):gsub("Enum.KeyCode.", "")
            kb.BackgroundColor3 = PURPLE_MID
            listening = false
        end
    end)
end

