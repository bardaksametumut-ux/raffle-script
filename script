-- THIRD PERSON
-- ============================================================
local OrigCameraMode
local function SetThirdPerson(on)
    if on then
        OrigCameraMode = LP.CameraMode
        LP.CameraMode = Enum.CameraMode.Classic
        Camera.CameraType = Enum.CameraType.Custom
        -- Push cam back
        RunService:BindToRenderStep("ThirdPersonCam", Enum.RenderPriority.Camera.Value + 1, function()
            if not State.third_person then return end
            local char = LP.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    Camera.CFrame = CFrame.new(
                        hrp.Position + hrp.CFrame.LookVector * -8 + Vector3.new(0, 3, 0),
                        hrp.Position + Vector3.new(0, 1.5, 0)
                    )
                end
            end
        end)
    else
        RunService:UnbindFromRenderStep("ThirdPersonCam")
        if OrigCameraMode then
            LP.CameraMode = OrigCameraMode
        end
        Camera.CameraType = Enum.CameraType.Custom
    end
end

