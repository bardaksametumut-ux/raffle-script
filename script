local OrigCamMode
local function SetThirdPerson(on)
    if on then
        OrigCamMode=LP.CameraMode
        LP.CameraMode=Enum.CameraMode.Classic
        RunService:BindToRenderStep("TP",Enum.RenderPriority.Camera.Value+1,function()
            if not S.third_person then return end
            local char=LP.Character; if not char then return end
            local hrp=char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
            Camera.CFrame=CFrame.new(
                hrp.Position+hrp.CFrame.LookVector*-7+Vector3.new(0,2.5,0),
                hrp.Position+Vector3.new(0,1,0)
