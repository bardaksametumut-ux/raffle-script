-- ══ UTILS ══
local function getChar(p)  return p and p.Character end
local function getHRP(p)
    local c = getChar(p)
    return c and (c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso"))
end
local function getHum(p)
    local c = getChar(p)
    return c and c:FindFirstChildOfClass("Humanoid")
end
local function getBone(p, b)
    local c = getChar(p)
    return c and c:FindFirstChild(b)
end
local function alive(p)
    local h = getHum(p)
    return h and h.Health > 0
end
local function w2v(pos)
    local sp, vis = cam:WorldToViewportPoint(pos)
    return Vector2.new(sp.X, sp.Y), sp.Z > 0
end
local function enemies()
    local t = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp and alive(p) then t[#t+1] = p end
    end
    return t
end
local function closestToCenter(fov)
    local best, bestD = nil, fov
    local mid = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
    for _, p in ipairs(enemies()) do
        local b = getBone(p, cfg.aim_bone)
        if b then
            local sp, vis = w2v(b.Position)
            if vis then
                local d = (sp - mid).Magnitude
                if d < bestD then bestD = d; best = p end
            end
        end
    end
    return best
end

-- ══ ESP ══
local espPool = {}

local function espInit(p)
    if espPool[p] then return end
    local function D(t, props)
        local d = Drawing.new(t)
        for k, v in pairs(props) do d[k] = v end
        return d
    end
    espPool[p] = {
        box    = D("Square", {Visible=false, Filled=false,
                               Color=cfg.esp_color, Thickness=cfg.esp_thickness}),
        name   = D("Text",   {Visible=false, Size=13,
                               Color=Color3.new(1,1,1), Center=true, Outline=true}),
        hbg    = D("Square", {Visible=false, Filled=true,
                               Color=Color3.fromRGB(10,10,10), Thickness=0}),
        hbar   = D("Square", {Visible=false, Filled=true, Thickness=0}),
        tracer = D("Line",   {Visible=false, Color=cfg.esp_color, Thickness=1}),
    }
end

local function espRemove(p)
    if not espPool[p] then return end
    for _, d in pairs(espPool[p]) do d:Remove() end
    espPool[p] = nil
end

local function espUpdate()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == lp then continue end
        espInit(p)
        local ob = espPool[p]
        local visible = cfg.esp and alive(p)
        if not visible then
            for _, d in pairs(ob) do d.Visible = false end
            continue
        end
        local c    = p.Character
        local root = c and c:FindFirstChild("HumanoidRootPart")
        local head = c and c:FindFirstChild("Head")
        if not root or not head then
            for _, d in pairs(ob) do d.Visible = false end
            continue
        end
        local hTop      = head.Position + Vector3.new(0, head.Size.Y*0.5, 0)
        local rSP, rOK  = w2v(root.Position)
        local hSP, hOK  = w2v(hTop)
        if not (rOK and hOK) then
            for _, d in pairs(ob) do d.Visible = false end
            continue
        end
        local h = math.abs(hSP.Y - rSP.Y) * 2.3
        local w = h * 0.55
        local x = hSP.X - w*0.5
        local y = hSP.Y - h*0.05

        ob.box.Visible  = cfg.esp_boxes
        ob.box.Position = Vector2.new(x, y)
        ob.box.Size     = Vector2.new(w, h)
        ob.box.Color    = cfg.esp_color

        ob.name.Visible  = cfg.esp_names
        ob.name.Text     = p.Name
        ob.name.Position = Vector2.new(hSP.X, y-16)

        local hum = getHum(p)
        local pct = hum and math.clamp(hum.Health/hum.MaxHealth, 0, 1) or 0
        local barH = h * pct
        ob.hbg.Visible  = cfg.esp_health
        ob.hbg.Position = Vector2.new(x-6, y)
        ob.hbg.Size     = Vector2.new(4, h)
        ob.hbar.Visible  = cfg.esp_health
        ob.hbar.Position = Vector2.new(x-6, y+(h-barH))
        ob.hbar.Size     = Vector2.new(4, barH)
        ob.hbar.Color    = Color3.fromRGB(
            math.floor((1-pct)*255),
            math.floor(pct*210), 35)

        local vp = cam.ViewportSize
        ob.tracer.Visible = cfg.esp_tracers
        ob.tracer.From    = Vector2.new(vp.X*0.5, vp.Y)
        ob.tracer.To      = rSP
    end
end

-- ══ AIMBOT ══
local fovCircle = Drawing.new("Circle")
fovCircle.Filled    = false
fovCircle.Color     = Color3.fromRGB(255,255,255)
fovCircle.Thickness = 1
fovCircle.NumSides  = 64
fovCircle.Visible   = false

local function aimbotUpdate()
    local vp  = cam.ViewportSize
    local mid = Vector2.new(vp.X*0.5, vp.Y*0.5)
    fovCircle.Visible  = cfg.aimbot
    fovCircle.Position = mid
    fovCircle.Radius   = cfg.aim_fov
    if not cfg.aimbot then return end
    if not UserInputService:IsMouseButtonPressed(cfg.aim_key) then return end
    local target = closestToCenter(cfg.aim_fov)
    if not target then return end
    local b = getBone(target, cfg.aim_bone)
    if not b then return end
    if cfg.silent_aim then
        local bSP, ok = w2v(b.Position)
        if ok then
            local cur = Vector2.new(mouse.X, mouse.Y)
            local off = bSP - cur
            mmrel(off.X, off.Y)
            task.wait()
            mmrel(-off.X, -off.Y)
        end
        return
    end
    local bSP, ok = w2v(b.Position)
    if not ok then return end
    local cur   = Vector2.new(mouse.X, mouse.Y)
    local delta = (bSP - cur) * cfg.aim_smooth
    mmrel(delta.X, delta.Y)
end

