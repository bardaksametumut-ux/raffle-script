    lbl.TextSize            = 13
    lbl.TextColor3          = C.white
    lbl.TextXAlignment      = Enum.TextXAlignment.Left
    lbl.Text                = label

    -- Switch track
    local track = Instance.new("Frame", row)
    track.Size            = UDim2.new(0, 40, 0, 20)
    track.Position        = UDim2.new(1, -52, 0.5, -10)
    track.BackgroundColor3= C.bg3
    track.BorderSizePixel = 0
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

    local trackStroke = Instance.new("UIStroke", track)
    trackStroke.Color     = C.gray
    trackStroke.Thickness = 1

    -- Switch knob
    local knob = Instance.new("Frame", track)
    knob.Size            = UDim2.new(0, 16, 0, 16)
    knob.Position        = UDim2.new(0, 2, 0.5, -8)
    knob.BackgroundColor3= C.gray
    knob.BorderSizePixel = 0
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local function syncVisual()
        local on = cfg[cfgKey]
        TweenService:Create(track, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {
            BackgroundColor3 = on and C.purple or C.bg3,
        }):Play()
        TweenService:Create(trackStroke, TweenInfo.new(0.18), {
            Color = on and C.purpleL or C.gray,
        }):Play()
        TweenService:Create(knob, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Position         = on and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8),
            BackgroundColor3 = on and C.orangeL or C.gray,
        }):Play()
        lbl.TextColor3 = on and C.white or C.gray
    end

    syncVisual()

    local btn = Instance.new("TextButton", row)
    btn.Size               = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text               = ""

    btn.MouseEnter:Connect(function()
        TweenService:Create(hoverFrame, TweenInfo.new(0.12), {
            BackgroundTransparency = 0.94,
        }):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(hoverFrame, TweenInfo.new(0.12), {
            BackgroundTransparency = 1,
        }):Play()
    end)
    btn.MouseButton1Click:Connect(function()
        cfg[cfgKey] = not cfg[cfgKey]
        syncVisual()
        if sideEffect then sideEffect() end
    end)

    return syncVisual
end

