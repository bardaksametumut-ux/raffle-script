local Cam = workspace.CurrentCamera

-- ═══════════════════════════════════════
-- CONFIG
-- ═══════════════════════════════════════
local CFG = {
    MenuKey = Enum.KeyCode.RightShift,
    AimKey = Enum.KeyCode.E,
    AimFOV = 180,
    AimSmooth = 0.12,
    AimTeamCheck = true,
    ESP = false,
    Rainbow = false,
    BigHead = false,
    Speed = false,
    SpeedVal = 60,
    Jump = false,
    JumpVal = 120
}

-- ═══════════════════════════════════════
-- UI (Mor/Siyah Minimal)
-- ═══════════════════════════════════════
local function buildUI()
    local sg = Instance.new("ScreenGui", LP:WaitForChild("PlayerGui"))
    sg.Name = "RaffleHub4080"
    sg.ResetOnSpawn = false

    local main = Instance.new("Frame", sg)
    main.Size = UDim2.new(0,320,0,260)
    main.Position = UDim2.new(0.5,-160,0.5,-130)
    main.BackgroundColor3 = Color3.fromRGB(13,13,13)
    main.BorderSizePixel = 0
    main.Visible = false
    Instance.new("UICorner", main).CornerRadius = UDim.new(0,8)
    local st = Instance.new("UIStroke", main)
    st.Color = Color3.fromRGB(155,89,182)
    st.Thickness = 2

    local title = Instance.new("TextLabel", main)
    title.Size = UDim2.new(1,0,0,30)
    title.BackgroundTransparency = 1
    title.Text = "RAFFLE HUB | 4080"
    title.TextColor3 = Color3.fromRGB(155,89,182)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 14

    local list = Instance.new("ScrollingFrame", main)
    list.Size = UDim2.new(1,-12,1,-38)
    list.Position = UDim2.new(0,6,0,34)
    list.BackgroundTransparency = 1
    list.ScrollBarThickness = 3
    Instance.new("UIListLayout", list).Padding = UDim.new(0,4)

    local function toggle(label, key)
        local f = Instance.new("TextButton", list)
        f.Size = UDim2.new(1,0,0,26)
        f.BackgroundColor3 = Color3.fromRGB(25,25,25)
        f.Text = label .. ": OFF"
        f.TextColor3 = Color3.fromRGB(200,200,200)
        f.Font = Enum.Font.Gotham
        f.TextSize = 12
        Instance.new("UICorner", f).CornerRadius = UDim.new(0,4)
        f.MouseButton1Click:Connect(function()
            CFG[key] = not CFG[key]
            f.Text = label .. (CFG[key] and ": ON" or ": OFF")
            f.TextColor3 = CFG[key] and Color3.fromRGB(155,89,182) or Color3.fromRGB(200,200,200)
        end)
    end

    toggle("ESP", "ESP")
    toggle("Rainbow Body", "Rainbow")
    toggle("Big Heads", "BigHead")
    toggle("Super Speed", "Speed")
    toggle("Super Jump", "Jump")

    UIS.InputBegan:Connect(function(i, gpe)
        if gpe then return end
        if i.KeyCode == CFG.MenuKey then
            main.Visible = not main.Visible
        end
    end)

    return sg
end

-- ═══════════════════════════════════════
-- AIMBOT (E Tuşu)
-- ═══════════════════════════════════════
local function getTarget()
    local best, dist = nil, CFG.AimFOV
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            if CFG.AimTeamCheck and p.Team == LP.Team then continue end
            local c = p.Character
            local h = c and c:FindFirstChild("Head")
            local hum = c and c:FindFirstChildOfClass("Humanoid")
            if h and hum and hum.Health > 0 then
                local sp, os = Cam:WorldToViewportPoint(h.Position)
                if os then
                    local d = (Vector2.new(sp.X, sp.Y) - UIS:GetMouseLocation()).Magnitude
                    if d < dist then dist, best = d, h end
                end
            end
        end
    end
    return best
end

