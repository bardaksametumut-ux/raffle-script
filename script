local Drawings = {}
local function D(c) local d=Drawing.new(c); table.insert(Drawings,d); return d end

local ESPCache = {}
local function GetCache(p)
    if ESPCache[p] then return ESPCache[p] end
    local t={box=D("Square"),fill=D("Square"),name=D("Text"),
             hp=D("Text"),dist=D("Text"),tracer=D("Line"),
             arrow=D("Triangle"),bones={}}
    for i=1,15 do t.bones[i]=D("Line") end
    ESPCache[p]=t; return t
end
Players.PlayerRemoving:Connect(function(p)
    local c=ESPCache[p]; if not c then return end
    c.box:Remove();c.fill:Remove();c.name:Remove()
    c.hp:Remove();c.dist:Remove();c.tracer:Remove();c.arrow:Remove()
    for _,b in ipairs(c.bones) do b:Remove() end
    ESPCache[p]=nil
end)
local function HideAll(c)
    c.box.Visible=false;c.fill.Visible=false;c.name.Visible=false
    c.hp.Visible=false;c.dist.Visible=false;c.tracer.Visible=false
    c.arrow.Visible=false
    for _,b in ipairs(c.bones) do b.Visible=false end
end
local function ESPColor(p)
    if S.esp_color_mode=="Static" then return S.esp_static_color end
    local h=p.Character and p.Character:FindFirstChildOfClass("Humanoid")
    if h then local r=1-h.Health/h.MaxHealth
        return Color3.fromRGB(math.floor(r*255),math.floor((1-r)*200),50) end
    return C.pa
end

