local TABS, PANELS = {}, {}

local function MakeTab(name, order)
    local btn = Instance.new("TextButton")
    btn.Size             = UDim2.new(0, 120, 1, 0)
    btn.BackgroundColor3 = C.pd
    btn.TextColor3       = C.gt
    btn.Text             = name
    btn.TextSize         = 12
    btn.Font             = Enum.Font.GothamSemibold
    btn.BorderSizePixel  = 0
    btn.LayoutOrder      = order
    btn.Parent           = TabBar

    local panel = Instance.new("ScrollingFrame")
    panel.Size                = UDim2.new(1, 0, 1, 0)
    panel.BackgroundTransparency = 1
    panel.BorderSizePixel     = 0
    panel.ScrollBarThickness  = 4
    panel.ScrollBarImageColor3= C.pa
    panel.CanvasSize          = UDim2.new(0,0,0,0)
    panel.AutomaticCanvasSize = Enum.AutomaticSize.Y
    panel.Visible             = false
    panel.Parent              = Content

    local lay = Instance.new("UIListLayout")
    lay.SortOrder = Enum.SortOrder.LayoutOrder
    lay.Padding   = UDim.new(0, 5)
    lay.Parent    = panel

    local pad = Instance.new("UIPadding")
    pad.PaddingLeft  = UDim.new(0, 10)
    pad.PaddingRight = UDim.new(0, 10)
    pad.PaddingTop   = UDim.new(0, 8)
    pad.Parent       = panel

    TABS[name]   = btn
    PANELS[name] = panel

    btn.MouseButton1Click:Connect(function()
        for n, p in pairs(PANELS) do
            p.Visible = (n == name)
            TABS[n].BackgroundColor3 = (n==name) and C.pm or C.pd
            TABS[n].TextColor3       = (n==name) and C.wh or C.gt
        end
    end)
    return panel
end

local ord = 0
local function O() ord=ord+1; return ord end

local function SecLbl(pan, txt)
