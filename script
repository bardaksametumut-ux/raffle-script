local Drawings = {}
local function NewDrawing(class)
    local d = Drawing.new(class)
    table.insert(Drawings, d)
    return d
end

-- Per-player drawing cache
local ESPCache = {}

local function GetESPForPlayer(p)
    if not ESPCache[p] then
        ESPCache[p] = {
            box      = NewDrawing("Square"),
            fill     = NewDrawing("Square"),
            name     = NewDrawing("Text"),
            health   = NewDrawing("Text"),
            dist     = NewDrawing("Text"),
            tracer   = NewDrawing("Line"),
            arrow    = NewDrawing("Triangle"),
            -- skeleton: 15 lines for R6/R15 approximation
            bones    = (function()
                local t = {}
                for i=1,15 do t[i] = NewDrawing("Line") end
                return t
            end)(),
        }
    end
    return ESPCache[p]
end

local function HideESP(cache)
    cache.box.Visible     = false
    cache.fill.Visible    = false
    cache.name.Visible    = false
    cache.health.Visible  = false
    cache.dist.Visible    = false
    cache.tracer.Visible  = false
    cache.arrow.Visible   = false
    for _, b in ipairs(cache.bones) do b.Visible = false end
end

-- ============================================================
-- COLOR MODE
-- ============================================================
local function ESPColor(p)
    if State.esp_color_mode == "Static" then
        return State.esp_static_color
    elseif State.esp_color_mode == "Health" then
        local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            local r = 1 - (hum.Health / hum.MaxHealth)
            return Color3.fromRGB(math.floor(r*255), math.floor((1-r)*200), 50)
        end
    end
    -- Default team-ish: just purple for everyone (FFA game)
    return PURPLE_ACCENT
end

-- ============================================================
-- ESP RENDER
-- ============================================================
local function RenderESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        local cache = GetESPForPlayer(p)
        local char  = p.Character

        if not State.esp_enabled or not char or not char:FindFirstChild("HumanoidRootPart") then
            HideESP(cache)
            continue
        end

        local hum    = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then HideESP(cache) continue end

        local hrp    = char.HumanoidRootPart
        local dist   = (Camera.CFrame.Position - hrp.Position).Magnitude

        if dist > State.esp_max_dist then HideESP(cache) continue end

        if State.esp_visibility_check and not IsVisible(Camera.CFrame.Position, hrp.Position) then
            HideESP(cache)
            continue
        end

        local color  = ESPColor(p)

        -- ── BOX ──────────────────────────────────────────────
        if State.esp_boxes then
            local topPos,    topVis    = WorldToViewport(hrp.Position + Vector3.new(0,  3.5, 0))
            local bottomPos, bottomVis = WorldToViewport(hrp.Position + Vector3.new(0, -3.5, 0))

            if topVis and bottomVis then
                local h   = math.abs(topPos.Y - bottomPos.Y)
                local w   = h * 0.6
                local x   = topPos.X - w/2
                local y   = topPos.Y

                -- filled
                cache.fill.Visible   = State.esp_filled_box
                cache.fill.Size      = Vector2.new(w, h)
                cache.fill.Position  = Vector2.new(x, y)
                cache.fill.Color     = color
                cache.fill.Filled    = true
                cache.fill.Transparency = 1 - State.esp_fill_opacity
                cache.fill.Thickness = 0

                -- outline
                cache.box.Visible    = true
                cache.box.Size       = Vector2.new(w, h)
                cache.box.Position   = Vector2.new(x, y)
                cache.box.Color      = color
                cache.box.Filled     = false
                cache.box.Thickness  = State.esp_box_thickness
                cache.box.Transparency = 1

                -- NAME
                if State.esp_names then
                    cache.name.Visible   = true
                    cache.name.Text      = p.Name
                    cache.name.Position  = Vector2.new(x + w/2, y - 18)
                    cache.name.Color     = WHITE
                    cache.name.Size      = 14
                    cache.name.Center    = true
                    cache.name.Outline   = true
                    cache.name.Transparency = 1
                else cache.name.Visible = false end

                -- HEALTH
                if State.esp_health then
                    local pct = math.floor((hum.Health / hum.MaxHealth) * 100)
                    cache.health.Visible  = true
                    cache.health.Text     = pct .. "%"
                    cache.health.Position = Vector2.new(x - 5, y + h/2 - 7)
                    cache.health.Color    = Color3.fromRGB(
                        math.floor((1 - pct/100)*255),
                        math.floor((pct/100)*200), 50)
                    cache.health.Size     = 13
                    cache.health.Center   = true
                    cache.health.Outline  = true
                    cache.health.Transparency = 1
                else cache.health.Visible = false end

                -- DISTANCE
                if State.esp_distance then
                    cache.dist.Visible   = true
                    cache.dist.Text      = math.floor(dist) .. "m"
                    cache.dist.Position  = Vector2.new(x + w/2, y + h + 2)
                    cache.dist.Color     = GRAY_TEXT
                    cache.dist.Size      = 12
                    cache.dist.Center    = true
                    cache.dist.Outline   = true
                    cache.dist.Transparency = 1
                else cache.dist.Visible = false end

                -- TRACER
                if State.esp_tracer then
                    local vp    = Camera.ViewportSize
                    local origY = (State.esp_tracer_origin == "Bottom" and vp.Y)
                                or (State.esp_tracer_origin == "Center" and vp.Y/2)
                                or 0
                    cache.tracer.Visible    = true
                    cache.tracer.From       = Vector2.new(vp.X/2, origY)
                    cache.tracer.To         = bottomPos
                    cache.tracer.Color      = color
                    cache.tracer.Thickness  = 1
                    cache.tracer.Transparency = 1
                else cache.tracer.Visible = false end

            else
                -- Off-screen arrow
                if State.esp_arrows then
                    local vp     = Camera.ViewportSize
                    local center = Vector2.new(vp.X/2, vp.Y/2)
                    local dir    = (topPos - center).Unit
                    local edgeX  = math.clamp(center.X + dir.X * 300, 20, vp.X-20)
                    local edgeY  = math.clamp(center.Y + dir.Y * 300, 20, vp.Y-20)
                    cache.arrow.Visible = true
                    cache.arrow.PointA  = Vector2.new(edgeX, edgeY)
                    cache.arrow.PointB  = Vector2.new(edgeX - dir.X*14 - dir.Y*8, edgeY - dir.Y*14 + dir.X*8)
                    cache.arrow.PointC  = Vector2.new(edgeX - dir.X*14 + dir.Y*8, edgeY - dir.Y*14 - dir.X*8)
                    cache.arrow.Color   = color
                    cache.arrow.Filled  = true
                    cache.arrow.Transparency = 1
                else cache.arrow.Visible = false end

                HideESP(cache)
                -- re-show arrow after HideESP clears it
                if State.esp_arrows then cache.arrow.Visible = true end
            end
        else
            cache.box.Visible  = false
            cache.fill.Visible = false
        end

        -- ── SKELETON (R6 approximation) ───────────────────────
        if State.esp_skeletons and char then
            local parts = {
                {char:FindFirstChild("Head"),             char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")},
                {char:FindFirstChild("UpperTorso"),       char:FindFirstChild("LowerTorso")},
                {char:FindFirstChild("LowerTorso"),       char:FindFirstChild("HumanoidRootPart")},
                {char:FindFirstChild("UpperTorso"),       char:FindFirstChild("RightUpperArm") or char:FindFirstChild("Right Arm")},
                {char:FindFirstChild("RightUpperArm"),    char:FindFirstChild("RightLowerArm")},
                {char:FindFirstChild("RightLowerArm"),    char:FindFirstChild("RightHand")},
                {char:FindFirstChild("UpperTorso"),       char:FindFirstChild("LeftUpperArm") or char:FindFirstChild("Left Arm")},
                {char:FindFirstChild("LeftUpperArm"),     char:FindFirstChild("LeftLowerArm")},
                {char:FindFirstChild("LeftLowerArm"),     char:FindFirstChild("LeftHand")},
                {char:FindFirstChild("LowerTorso"),       char:FindFirstChild("RightUpperLeg") or char:FindFirstChild("Right Leg")},
                {char:FindFirstChild("RightUpperLeg"),    char:FindFirstChild("RightLowerLeg")},
                {char:FindFirstChild("RightLowerLeg"),    char:FindFirstChild("RightFoot")},
                {char:FindFirstChild("LowerTorso"),       char:FindFirstChild("LeftUpperLeg") or char:FindFirstChild("Left Leg")},
                {char:FindFirstChild("LeftUpperLeg"),     char:FindFirstChild("LeftLowerLeg")},
                {char:FindFirstChild("LeftLowerLeg"),     char:FindFirstChild("LeftFoot")},
            }
            for i, pair in ipairs(parts) do
                local bone = cache.bones[i]
                if pair[1] and pair[2] then
                    local p1, v1 = WorldToViewport(pair[1].Position)
                    local p2, v2 = WorldToViewport(pair[2].Position)
                    if v1 and v2 then
                        bone.Visible    = true
                        bone.From       = p1
                        bone.To         = p2
                        bone.Color      = color
                        bone.Thickness  = 1
                        bone.Transparency = 1
                    else bone.Visible = false end
                else bone.Visible = false end
            end
        else
            for _, b in ipairs(cache.bones) do b.Visible = false end
        end
    end
end

