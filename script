local function GetClosestTarget()
    local vp     = Camera.ViewportSize
    local center = Vector2.new(vp.X/2, vp.Y/2)
    local best, bestDist = nil, math.huge

    for _, p in ipairs(GetAllEnemies()) do
        if State.aim_team_check then
            -- FFA game, no team filter needed — all enemies
        end
        local char = p.Character
        local part = char:FindFirstChild(State.aim_target_part) or char:FindFirstChild("HumanoidRootPart")
        if not part then continue end

        local screenPos, visible = WorldToViewport(part.Position)
        if not visible then continue end

        if State.esp_visibility_check and
           not IsVisible(Camera.CFrame.Position, part.Position) then continue end

        local d = (screenPos - center).Magnitude
        if d < State.aim_fov and d < bestDist then
            bestDist = d
            best = part
        end
    end
    return best
end

-- ============================================================
-- RAINBOW
-- ============================================================
local RainbowHue = 0
local function GetRainbowColor()
    return Color3.fromHSV(RainbowHue, 1, 1)
end

local function ApplyRainbowBody(char)
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
            local isWeapon = p:IsDescendantOf(char:FindFirstChildWhichIsA("Tool") or Instance.new("Folder"))
            if not isWeapon then
                p.Color = GetRainbowColor()
            end
        end
    end
end

local function ApplyRainbowWeapon(char)
    local tool = char:FindFirstChildWhichIsA("Tool")
    if tool then
        for _, p in ipairs(tool:GetDescendants()) do
            if p:IsA("BasePart") then
                p.Color = GetRainbowColor()
            end
        end
    end
end

