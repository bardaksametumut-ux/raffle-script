-- ============================================================
-- MEVLANA — SADECE GÖVDE DÖNER, BAŞ/KAMERA SABIT
-- ============================================================
local MevlanaConn
local function SetMevlana(on)
    if MevlanaConn then MevlanaConn:Disconnect(); MevlanaConn=nil end
    if not on then return end
    MevlanaConn=RunService.Heartbeat:Connect(function(dt)
        local char=LP.Character; if not char then return end
        local hrp=char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
        local head=char:FindFirstChild("Head")

        -- Kameranın mevcut yönünü kaydet
        local camCF=Camera.CFrame

        -- Sadece HRP'yi döndür (yatay eksen, Y ekseni etrafında)
        hrp.CFrame=hrp.CFrame*CFrame.Angles(0,math.rad(720*dt),0)

        -- Kamerayı geri getir (başın kameraya etkisini sıfırla)
        Camera.CFrame=camCF

        -- Baş varsa dünya uzayında sabit tut
        if head then
            local neck=char:FindFirstChild("Neck",true)
                 or (char:FindFirstChild("UpperTorso") and char.UpperTorso:FindFirstChild("Neck"))
                 or (char:FindFirstChild("Torso") and char.Torso:FindFirstChild("Neck"))
            if neck and neck:IsA("Motor6D") then
                -- HRP'nin dönüşünün tersini neck'e uygula (baş sabit kalır)
                local hrpRot=hrp.CFrame-hrp.CFrame.Position
                local invRot=hrpRot:Inverse()
                neck.C0=invRot*CFrame.new(0,1,0)*CFrame.Angles(-math.pi/2,0,math.pi)
            end
        end
    end)
end

-- ============================================================
-- KALKAN (Shield) — sınırsız
-- Oyun bir Shield değeri kullanıyor (IntValue veya NumberValue)
-- Her tick sıfırlanmadan önce max'a çekiyoruz
-- ============================================================
local ShieldConn

local function FindShieldValue(char)
    -- Yaygın isimler: Shield, Armor, Block, Guard
    local names={"Shield","shield","Armor","armor","Block","block","Guard","guard","Barrier","barrier"}
    -- Önce leaderstats / stats içinde ara
    for _,stat in ipairs({char,"leaderstats","PlayerData","Stats","stats"}) do
        local folder = type(stat)=="string" and LP:FindFirstChild(stat) or stat
        if folder then
            for _,n in ipairs(names) do
                local v=folder:FindFirstChild(n,true)
                if v and (v:IsA("NumberValue") or v:IsA("IntValue")) then
                    return v
                end
            end
        end
    end
    -- Tüm char descendants
    for _,v in ipairs(char:GetDescendants()) do
        if (v:IsA("NumberValue") or v:IsA("IntValue")) then
            local n=v.Name:lower()
            if n:find("shield") or n:find("armor") or n:find("block") then
                return v
            end
        end
    end
    -- LP leaderstats
    for _,v in ipairs(LP:GetDescendants()) do
        if (v:IsA("NumberValue") or v:IsA("IntValue")) then
            local n=v.Name:lower()
            if n:find("shield") or n:find("armor") or n:find("block") then
                return v
            end
        end
    end
    return nil
end

local function SetShield(on)
    if ShieldConn then ShieldConn:Disconnect(); ShieldConn=nil end
    if not on then return end
    ShieldConn=RunService.Heartbeat:Connect(function()
        local char=LP.Character; if not char then return end
        local sv=FindShieldValue(char)
        if sv then sv.Value=999999 end
    end)
end

-- ============================================================
-- UÇUŞ — velocity tabanlı, sunucu ışınlaması olmadan
-- Strateji: Humanoid.PlatformStand=true + AssemblyLinearVelocity ile hareket
-- ============================================================
local FlyConn
local FlyBodyVelocity
local FlyBodyGyro

local function SetFly(on)
    if FlyConn then FlyConn:Disconnect(); FlyConn=nil end
    if FlyBodyVelocity then FlyBodyVelocity:Destroy(); FlyBodyVelocity=nil end
    if FlyBodyGyro then FlyBodyGyro:Destroy(); FlyBodyGyro=nil end

    if not on then
        local char=LP.Character
        if char then
            local hum=char:FindFirstChildOfClass("Humanoid")
            if hum then hum.PlatformStand=false end
        end
        return
    end

    local char=LP.Character; if not char then return end
    local hrp=char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local hum=char:FindFirstChildOfClass("Humanoid"); if not hum then return end

    hum.PlatformStand=true

    -- BodyVelocity: hareketi kontrol eder
    FlyBodyVelocity=Instance.new("BodyVelocity")
    FlyBodyVelocity.Velocity=Vector3.zero
    FlyBodyVelocity.MaxForce=Vector3.new(1e5,1e5,1e5)
    FlyBodyVelocity.P=1e4
    FlyBodyVelocity.Parent=hrp

    -- BodyGyro: yönü sabit tutar (devrilme yok)
    FlyBodyGyro=Instance.new("BodyGyro")
    FlyBodyGyro.MaxTorque=Vector3.new(1e5,1e5,1e5)
    FlyBodyGyro.P=1e4
    FlyBodyGyro.CFrame=hrp.CFrame
    FlyBodyGyro.Parent=hrp

    FlyConn=RunService.RenderStepped:Connect(function()
        if not S.fly then return end
        local char2=LP.Character; if not char2 then return end
        local hrp2=char2:FindFirstChild("HumanoidRootPart"); if not hrp2 then return end
        if not FlyBodyVelocity or not FlyBodyVelocity.Parent then return end

        local spd=S.fly_speed
        local vel=Vector3.zero
        local camCF=Camera.CFrame

        -- WASD + QE uçuş kontrolleri
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            vel=vel+camCF.LookVector*spd
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            vel=vel-camCF.LookVector*spd
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            vel=vel-camCF.RightVector*spd
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            vel=vel+camCF.RightVector*spd
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            vel=vel+Vector3.new(0,spd,0)
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
        or UserInputService:IsKeyDown(Enum.KeyCode.C) then
            vel=vel-Vector3.new(0,spd,0)
        end

        FlyBodyVelocity.Velocity=vel
        FlyBodyGyro.CFrame=camCF
    end)
end

