-- ============================================================
-- ONE SHOT — damage tool hook
-- ============================================================
-- Fires every time a remote that looks like a damage call goes out.
-- We intercept via hookfunction on FireServer to set absurd damage.
-- This is the most common pattern for FPS games on Roblox.
-- If the game uses a different naming scheme, find the RemoteEvent
-- in ServerScriptService output or via :GetDescendants() scan.
local _origFireServer
local function HookOneShot()
    if not hookfunction then return end  -- executor must support hookfunction
    local RE = game:GetService("ReplicatedStorage")
    -- Scan for damage remote — common names in FPS titles
    local damageRemote
    for _, v in ipairs(RE:GetDescendants()) do
        if v:IsA("RemoteEvent") and
           (v.Name:lower():find("damage") or v.Name:lower():find("hit") or v.Name:lower():find("fire")) then
            damageRemote = v
            break
        end
    end
    if not damageRemote then return end  -- FILL: remote name if scan misses

    _origFireServer = hookfunction(damageRemote.FireServer, newcclosure(function(self, ...)
        if State.one_shot then
            -- Replace damage arg (usually first numeric arg) with 999
            local args = {...}
            for i, v in ipairs(args) do
                if type(v) == "number" and v > 0 and v < 500 then
                    args[i] = 999
                    break
                end
            end
            return _origFireServer(self, table.unpack(args))
        end
        return _origFireServer(self, ...)
    end))
end
pcall(HookOneShot)

