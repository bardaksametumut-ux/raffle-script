--  MAIN LOOP
-- ══════════════════════════════════════════════

local frames    = 0
local smoothFPS = 60

RunService.Heartbeat:Connect(function(dt)
    frames    = frames + 1
    smoothFPS = smoothFPS + (1/dt - smoothFPS) * 0.05

    espUpdate()
    aimbotUpdate()
    killAuraUpdate()

    if cfg.speed then speedApply() end

    if frames % 8 == 0 then
        if cfg.ghost  then ghostApply()  end
        if cfg.hitbox then hitboxApply() end
        fovApply()
    end

    if frames % 4  == 0 then trackerUpdate() end

    if frames % 30 == 0 then
        wmLabel.Text = ("RAZE v1.0  |  %s  |  %d fps"):format(
            lp.Name, math.floor(smoothFPS))
    end
end)

