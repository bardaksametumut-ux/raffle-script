local function GetTarget()
    local vp=Camera.ViewportSize
    local cen=Vector2.new(vp.X/2,vp.Y/2)
    local best,bestD=nil,math.huge
    for _,p in ipairs(Players:GetPlayers()) do
        if p==LP then continue end
        local char=p.Character; if not char then continue end
        local hum=char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health<=0 then continue end
        local part=char:FindFirstChild(S.aim_target_part) or char:FindFirstChild("HumanoidRootPart")
        if not part then continue end
        local sc,vis=Camera:WorldToViewportPoint(part.Position)
        if not vis then continue end
        local d=(Vector2.new(sc.X,sc.Y)-cen).Magnitude
        if d<S.aim_fov and d<bestD then bestD=d; best=part end
    end
    return best
end

