-- ============================================================
-- RAYCAST
-- ============================================================
local RayP = RaycastParams.new()
RayP.FilterType = Enum.RaycastFilterType.Exclude
RayP.FilterDescendantsInstances = {LChar}

local function IsVisible(origin, tgt)
    local r = WS:Raycast(origin, tgt - origin, RayP)
    if not r then return true end
    return r.Instance and r.Instance.Parent and
           Players:GetPlayerFromCharacter(r.Instance.Parent) ~= nil
end

