end

-- ============================================================
-- MAIN LOOP
-- ============================================================
RunService.RenderStepped:Connect(function(dt)
    RainbowHue = (RainbowHue + dt * 0.5) % 1

    -- ESP
    RenderESP()

    -- FOV circle
    if State.aim_enabled and State.aim_draw_fov then
        local vp = Camera.ViewportSize
        FovCircle.Visible  = true
        FovCircle.Position = Vector2.new(vp.X/2, vp.Y/2)
        FovCircle.Radius   = State.aim_fov
    else FovCircle.Visible = false end

    -- Aimbot
    if State.aim_enabled and AimActive then
        local target = GetClosestTarget()
        if target then
            local targetPos = target.Position
            if State.aim_prediction then
                local vel = target.AssemblyLinearVelocity or Vector3.zero
                targetPos = targetPos + vel * (State.aim_prediction_ms / 1000)
            end
            local dir = (targetPos - Camera.CFrame.Position).Unit
            Camera.CFrame = Camera.CFrame:Lerp(
                CFrame.new(Camera.CFrame.Position, Camera.CFrame.Position + dir),
                State.aim_smoothness
            )
        end
    end

    -- Rainbow
    local lc = LP.Character
    if lc then
        if State.rainbow_body   then ApplyRainbowBody(lc)   end
        if State.rainbow_weapon then ApplyRainbowWeapon(lc) end
    end

    -- Big heads
    if State.big_heads then ApplyBigHeads() end
end)

-- Heartbeat for stats (separate so no frame skip on speed/jump)
