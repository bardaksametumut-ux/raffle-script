-- ESP cache — oyuncu başına
local ESPCache = {}
local function GetCache(p)
    if ESPCache[p] then return ESPCache[p] end
    local t = {
        box    = D("Square"),
        fill   = D("Square"),
        name   = D("Text"),
        hp     = D("Text"),
        dist   = D("Text"),
        tracer = D("Line"),
        arrow  = D("Triangle"),
        bones  = {},
    }
    for i=1,15 do t.bones[i] = D("Line") end
    ESPCache[p] = t
    return t
end

-- Çıkan oyuncuların drawing'lerini temizle
Players.PlayerRemoving:Connect(function(p)
    local c = ESPCache[p]
    if not c then return end
    c.box:Remove(); c.fill:Remove(); c.name:Remove()
    c.hp:Remove();  c.dist:Remove(); c.tracer:Remove(); c.arrow:Remove()
    for _, b in ipairs(c.bones) do b:Remove() end
    ESPCache[p] = nil
end)

local function HideAll(c)
    c.box.Visible    = false; c.fill.Visible  = false
    c.name.Visible   = false; c.hp.Visible    = false
    c.dist.Visible   = false; c.tracer.Visible= false
    c.arrow.Visible  = false
    for _, b in ipairs(c.bones) do b.Visible = false end
end

local function ESPColor(p)
    if S.esp_color_mode == "Static" then return S.esp_static_color end
    if S.esp_color_mode == "Health" then
        local h = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
        if h then
            local r = 1 - h.Health/h.MaxHealth
            return Color3.fromRGB(math.floor(r*255), math.floor((1-r)*200), 50)
        end
    end
    return C.pa
end

-- ============================================================
-- ESP RENDER
-- ============================================================
local function RenderESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        local cache = GetCache(p)
        local char  = p.Character
        if not S.esp_enabled or not char then HideAll(cache) continue end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then HideAll(cache) continue end

        local camPos = Camera.CFrame.Position
        local dist   = (camPos - hrp.Position).Magnitude
        if dist > S.esp_max_dist then HideAll(cache) continue end

        if S.esp_visibility_check and not IsVisible(camPos, hrp.Position) then
            HideAll(cache) continue
        end

        local col = ESPColor(p)

        local function W2V(pos)
            local s, v = Camera:WorldToViewportPoint(pos)
            return Vector2.new(s.X, s.Y), v
        end

        local topP,  topV    = W2V(hrp.Position + Vector3.new(0,  3.5, 0))
        local botP,  botV    = W2V(hrp.Position + Vector3.new(0, -3.5, 0))

        if not (topV and botV) then
            -- ok işareti
            if S.esp_arrows then
                local vp  = Camera.ViewportSize
                local cen = Vector2.new(vp.X/2, vp.Y/2)
                local dir = (topP - cen)
                local mag = dir.Magnitude
                if mag > 0 then
                    dir = dir / mag
                    local ex = math.clamp(cen.X + dir.X*280, 20, vp.X-20)
                    local ey = math.clamp(cen.Y + dir.Y*280, 20, vp.Y-20)
                    cache.arrow.Visible = true
                    cache.arrow.PointA  = Vector2.new(ex, ey)
                    cache.arrow.PointB  = Vector2.new(ex - dir.X*12 - dir.Y*7, ey - dir.Y*12 + dir.X*7)
                    cache.arrow.PointC  = Vector2.new(ex - dir.X*12 + dir.Y*7, ey - dir.Y*12 - dir.X*7)
                    cache.arrow.Color   = col
                    cache.arrow.Filled  = true
                    cache.arrow.Transparency = 1
                end
            else cache.arrow.Visible = false end

            cache.box.Visible  = false; cache.fill.Visible = false
            cache.name.Visible = false; cache.hp.Visible   = false
            cache.dist.Visible = false; cache.tracer.Visible = false
            for _, b in ipairs(cache.bones) do b.Visible = false end
            continue
        end

        cache.arrow.Visible = false

        local h = math.abs(topP.Y - botP.Y)
        local w = math.max(h * 0.55, 20)
        local x = topP.X - w/2
        local y = topP.Y

        -- fill
        cache.fill.Visible      = S.esp_filled_box
        cache.fill.Size         = Vector2.new(w, h)
        cache.fill.Position     = Vector2.new(x, y)
        cache.fill.Color        = col
        cache.fill.Filled       = true
        cache.fill.Transparency = 1 - (S.esp_fill_opacity/100)
        cache.fill.Thickness    = 0

        -- box
        cache.box.Visible       = S.esp_boxes
        cache.box.Size          = Vector2.new(w, h)
        cache.box.Position      = Vector2.new(x, y)
        cache.box.Color         = col
        cache.box.Filled        = false
        cache.box.Thickness     = S.esp_box_thickness
        cache.box.Transparency  = 1

        -- isim
        cache.name.Visible      = S.esp_names
        cache.name.Text         = p.Name
        cache.name.Position     = Vector2.new(x + w/2, y - 17)
        cache.name.Color        = C.wh
        cache.name.Size         = 13
        cache.name.Center       = true
        cache.name.Outline      = true
        cache.name.Transparency = 1

        -- sağlık
        if S.esp_health then
            local pct = math.floor(hum.Health / hum.MaxHealth * 100)
            cache.hp.Visible      = true
            cache.hp.Text         = pct.."%"
            cache.hp.Position     = Vector2.new(x - 4, y + h/2 - 7)
            cache.hp.Color        = Color3.fromRGB(math.floor((1-pct/100)*255), math.floor((pct/100)*200), 50)
            cache.hp.Size         = 12
            cache.hp.Center       = true
            cache.hp.Outline      = true
            cache.hp.Transparency = 1
        else cache.hp.Visible = false end

        -- mesafe
        cache.dist.Visible      = S.esp_distance
        cache.dist.Text         = math.floor(dist).."m"
        cache.dist.Position     = Vector2.new(x + w/2, y + h + 2)
        cache.dist.Color        = C.gt
        cache.dist.Size         = 11
        cache.dist.Center       = true
        cache.dist.Outline      = true
        cache.dist.Transparency = 1

        -- tracer
        if S.esp_tracer then
            local vp    = Camera.ViewportSize
            local origY = S.esp_tracer_origin == "Bottom" and vp.Y
                       or S.esp_tracer_origin == "Center" and vp.Y/2 or 0
            cache.tracer.Visible    = true
            cache.tracer.From       = Vector2.new(vp.X/2, origY)
            cache.tracer.To         = botP
            cache.tracer.Color      = col
            cache.tracer.Thickness  = 1
            cache.tracer.Transparency = 1
        else cache.tracer.Visible = false end

        -- skeleton
        if S.esp_skeletons then
            local sk = {
                {"Head",          "UpperTorso"},  {"Head",        "Torso"},
                {"UpperTorso",    "LowerTorso"},  {"Torso",       "HumanoidRootPart"},
                {"LowerTorso",    "HumanoidRootPart"},
                {"UpperTorso",    "RightUpperArm"}, {"UpperTorso", "Right Arm"},
                {"RightUpperArm", "RightLowerArm"}, {"RightLowerArm","RightHand"},
                {"UpperTorso",    "LeftUpperArm"},  {"UpperTorso", "Left Arm"},
                {"LeftUpperArm",  "LeftLowerArm"},  {"LeftLowerArm","LeftHand"},
                {"LowerTorso",    "RightUpperLeg"}, {"LowerTorso", "Right Leg"},
            }
            for i, pair in ipairs(sk) do
                local b = cache.bones[i]
                local p1 = char:FindFirstChild(pair[1])
                local p2 = char:FindFirstChild(pair[2])
                if p1 and p2 then
                    local s1, v1 = W2V(p1.Position)
                    local s2, v2 = W2V(p2.Position)
                    if v1 and v2 then
                        b.Visible    = true
                        b.From       = s1; b.To = s2
                        b.Color      = col
                        b.Thickness  = 1
                        b.Transparency = 1
                    else b.Visible = false end
                else b.Visible = false end
            end
        else
            for _, b in ipairs(cache.bones) do b.Visible = false end
        end
    end
end

